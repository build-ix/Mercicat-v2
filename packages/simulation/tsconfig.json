{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mercicat/shared": ["../../packages/shared/dist/index.d.ts"],
      "@mercicat/content": ["../../packages/content/dist/index.d.ts"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": ["src"]
}
