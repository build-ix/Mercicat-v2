{
  "name": "mercicat",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron-main.cjs",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --sort run build",
    "package:electron": "node scripts/build-electron.mjs",
    "dist:win": "pnpm build && pnpm package:electron && electron-builder --config electron-builder.yml --win nsis --x64",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
