{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mercicat/shared": ["packages/shared/src/index.ts"],
      "@mercicat/content": ["packages/content/src/index.ts"],
      "@mercicat/simulation": ["packages/simulation/src/index.ts"],
      "@mercicat/protocol": ["packages/protocol/src/index.ts"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true
  },
  "include": ["apps", "packages"],
  "exclude": ["node_modules", "dist"]
}
