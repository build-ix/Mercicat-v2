{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mercicat/shared": ["packages/shared/dist/index.d.ts"],
      "@mercicat/content": ["packages/content/dist/index.d.ts"],
      "@mercicat/simulation": ["packages/simulation/dist/index.d.ts"],
      "@mercicat/protocol": ["packages/protocol/dist/index.d.ts"],
      "@mercicat/client": ["packages/client/src/index.ts"],
      "@mercicat/client-net/*": ["packages/client-net/src/*"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["apps", "packages"],
  "exclude": ["node_modules", "dist"]
}
